        {
          "name": "get aeropuertos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function() {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"El body tiene propiedad data\", function() {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body).to.have.property(\"data\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"data es un array con aeropuertos\", function() {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body.data).to.be.an(\"array\");\r",
                  "    pm.expect(body.data.length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Cada aeropuerto tiene id, nombre y ciudad\", function() {\r",
                  "    const body = pm.response.json();\r",
                  "    const primero = body.data[0];\r",
                  "    pm.expect(primero).to.have.property(\"id\");\r",
                  "    pm.expect(primero.attributes).to.have.property(\"name\");\r",
                  "    pm.expect(primero.attributes).to.have.property(\"city\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Responde en menos de 2 segundos\", function() {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});"
                ],
