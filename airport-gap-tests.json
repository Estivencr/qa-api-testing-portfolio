          "name": "POST Calcular distancia - Positivo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function(){\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Devuelve distancia en millas y kilómetros\", function() {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body.data.attributes).to.have.property(\"miles\");\r",
                  "    pm.expect(body.data.attributes).to.have.property(\"kilometers\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"La distancia es un número positivo\", function(){\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body.data.attributes.miles).to.be.a('number');\r",
                  "    pm.expect(body.data.attributes.miles).to.be.greaterThan(0);\r",
                  "    pm.expect(body.data.attributes.kilometers).to.be.a('number');\r",
                  "    pm.expect(body.data.attributes.kilometers).to.be.greaterThan(0);\r",
                  "});"
                ],
